{
  "__inputs": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "devops 微服务可观测性仪表盘：服务 RED（HTTP/gRPC 服务端+客户端）+ 边缘网关 + 依赖 USE（MySQL/Redis 连接池）+ Go 运行时。用 $service/$env 变量过滤，新增服务无需复制面板。业务指标（http_server_*）来自 OTel Prometheus exporter，service_name 标签来自 OTel Resource。HTTP 延迟分位独立展示，其他对照指标按图例名固定颜色区分。",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "Jaeger UI",
      "type": "link",
      "url": "http://localhost:16686"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP QPS（按路由）",
      "description": "sum(rate(http_server_requests_total[1m])) by (route)，随 $service/$env 过滤",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_total{service_name=~\"$service\", deployment_environment=~\"$env\"}[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "错误率：应用 5xx vs 网关边缘",
      "description": "同一图上对照两条错误率曲线：应用 5xx（红，http_server_requests_total，业务/服务故障）与网关 4xx+5xx（橙，envoy_http_downstream_rq，含网关自产错误如无路由、upstream 挂——后端永远看不到）。边缘抬高而应用平稳 = 网关/路由问题；两边一起高 = 服务本身。无错误时 or vector(0) 补零显示 0；整体无数据 = 无流量。>1% 黄、>5% 红",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "应用 5xx"
            },
            "properties": [
              {
                "id": "color",
                "type": "fixed",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "网关 4xx+5xx"
            },
            "properties": [
              {
                "id": "color",
                "type": "fixed",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_total{service_name=~\"$service\", deployment_environment=~\"$env\", status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_requests_total{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m]))",
          "legendFormat": "应用 5xx"
        },
        {
          "refId": "B",
          "expr": "(sum(rate(envoy_http_downstream_rq{job=\"higress-gateway\", http_conn_manager_prefix=~\"outbound.*\", response_code_class=~\"4xx|5xx\"}[5m])) or vector(0)) / (sum(rate(envoy_http_downstream_rq{job=\"higress-gateway\", http_conn_manager_prefix=~\"outbound.*\"}[5m])) or vector(0))",
          "legendFormat": "网关 4xx+5xx"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP 状态码分布",
      "description": "按具体状态码看请求速率：200/401/403/404/500 等，4xx 飙升（如 401 打爆）不会体现在 5xx 面板里",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_total{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP 延迟 P95（按路由）",
      "description": "按路由展示 HTTP 请求延迟 P95，便于定位整体慢请求的路由；与 P99 面板对照可判断是否主要由尾部请求拉高延迟。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*"
            },
            "properties": [
              {
                "id": "color",
                "type": "fixed",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m])) by (le, route))",
          "legendFormat": "P95 {{route}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP 延迟 P99（按路由）",
      "description": "按路由展示 HTTP 请求延迟 P99，反映尾部慢请求；持续逼近 SLO 1s（DevOpsHTTPP99High）即压测不达标。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*"
            },
            "properties": [
              {
                "id": "color",
                "type": "fixed",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m])) by (le, route))",
          "legendFormat": "P99 {{route}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "在途请求数（In-flight）",
      "description": "http_server_in_flight",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "http_server_in_flight{service_name=~\"$service\", deployment_environment=~\"$env\"}",
          "legendFormat": "{{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "gRPC 调用速率（服务端，方法×状态）",
      "description": "otelgrpc stats handler 自动产出；rpc_response_status_code != OK 即错误",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rpc_server_call_duration_seconds_count{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m])) by (rpc_method, rpc_response_status_code)",
          "legendFormat": "{{rpc_method}} [{{rpc_response_status_code}}]"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "gRPC P99 延迟：服务端 vs 客户端",
      "description": "同一图上对照 gRPC 两侧 P99：服务端（蓝，rpc_server_*，被调方视角）与客户端（紫，rpc_client_*，调用方视角——发号调用 devops-system → devops-id 的 BatchNext/预取补充端到端耗时）。服务端平稳而客户端高 = 网络/超时重试/客户端队列；两边一起高 = 服务本身慢（对照领域层基准约 427ns/号的天花板）。颜色按图例名正则覆盖，图例名区分方法",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "服务端.*"
            },
            "properties": [
              {
                "id": "color",
                "type": "fixed",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "客户端.*"
            },
            "properties": [
              {
                "id": "color",
                "type": "fixed",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(rpc_server_call_duration_seconds_bucket{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m])) by (le, rpc_method))",
          "legendFormat": "服务端 {{rpc_method}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum(rate(rpc_client_call_duration_seconds_bucket{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m])) by (le, rpc_method))",
          "legendFormat": "客户端 {{rpc_method}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "gRPC 客户端调用速率（方法×状态）",
      "description": "调用方视角（devops-system → devops-id）：client stats handler 在调用方进程导出 rpc_client_*，服务端“正常”但调用方超时重试的场景只有这层可见",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rpc_client_call_duration_seconds_count{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m])) by (rpc_method, rpc_response_status_code)",
          "legendFormat": "{{rpc_method}} [{{rpc_response_status_code}}]"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "网关边缘：QPS×状态类",
      "description": "Envoy HTTP connection manager 计数 envoy_http_downstream_rq，按 response_code_class（1xx–5xx）聚合；http_conn_manager_prefix=~outbound.* 只取 8080/8443 对外监听器（排除 admin/agent/stats 内部端点）。网关自产的 4xx/5xx（无路由、upstream 挂）后端永远看不到，只有这层可见",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (response_code_class) (rate(envoy_http_downstream_rq{job=\"higress-gateway\", http_conn_manager_prefix=~\"outbound.*\"}[5m]))",
          "legendFormat": "{{response_code_class}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "网关边缘：P99 延迟（按目标）",
      "description": "envoy_cluster_upstream_rq_time_bucket（毫秒直方图，/1000 转秒）P99，cluster_name 为 Envoy upstream 全名（outbound|端口||服务名.分组.命名空间.nacos），可区分灰度实例。业务流量经网关后才会出现对应 cluster 序列",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, cluster_name) (rate(envoy_cluster_upstream_rq_time_bucket{job=\"higress-gateway\", cluster_name=~\"outbound.*\"}[5m]))) / 1000",
          "legendFormat": "{{cluster_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "MySQL 连接池：在用/空闲/上限",
      "description": "go_sql_* 由 devops-infra InstrumentGORM 注册（client_golang DBStatsCollector），db_name 为标签；池饱和（在用逼近上限）是排队与超时错误的前兆。直采指标无 service_name 标签，按抓取目标（instance）落在 devops-system",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_sql_max_open_connections{job=\"devops-services\"}",
          "legendFormat": "上限 {{db_name}}"
        },
        {
          "refId": "B",
          "expr": "go_sql_in_use_connections{job=\"devops-services\"}",
          "legendFormat": "在用 {{db_name}}"
        },
        {
          "refId": "C",
          "expr": "go_sql_idle_connections{job=\"devops-services\"}",
          "legendFormat": "空闲 {{db_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "MySQL 连接池：等待",
      "description": "go_sql_wait_count_total（等待次数/秒）与 go_sql_wait_duration_seconds_total（等待秒/秒）。持续 > 0 说明 MaxOpenConns 不足或慢查询拖住连接",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (db_name) (rate(go_sql_wait_count_total{job=\"devops-services\"}[5m]))",
          "legendFormat": "等待次数/s {{db_name}}"
        },
        {
          "refId": "B",
          "expr": "sum by (db_name) (rate(go_sql_wait_duration_seconds_total{job=\"devops-services\"}[5m]))",
          "legendFormat": "等待时长/s {{db_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Redis 连接池：使用/空闲/上限",
      "description": "redisotel InstrumentMetrics 产出的 OTel db.client.connections.* 系列（Prometheus 名 db_client_connections_*），pool_name 为 Redis 地址",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "db_client_connections_max{service_name=~\"$service\", deployment_environment=~\"$env\"}",
          "legendFormat": "上限"
        },
        {
          "refId": "B",
          "expr": "db_client_connections_usage{state=\"used\", service_name=~\"$service\", deployment_environment=~\"$env\"}",
          "legendFormat": "在用 {{pool_name}}"
        },
        {
          "refId": "C",
          "expr": "db_client_connections_usage{state=\"idle\", service_name=~\"$service\", deployment_environment=~\"$env\"}",
          "legendFormat": "空闲 {{pool_name}}"
