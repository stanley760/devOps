          "legendFormat": "拒绝/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(idgen_fallback_total{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m])) or vector(0)",
          "legendFormat": "本地降级/s"
        },
        {
          "refId": "C",
          "expr": "sum(rate(idgen_lease_lost_total{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m])) or vector(0)",
          "legendFormat": "lease 失效/s"
        },
        {
          "refId": "D",
          "expr": "sum(rate(idgen_clock_rollback_total{service_name=~\"$service\", deployment_environment=~\"$env\"}[5m])) or vector(0)",
          "legendFormat": "时钟回拨/s"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
