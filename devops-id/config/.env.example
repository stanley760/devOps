# devops-id 本地开发环境变量
# 复制为 .env 并按实际修改（.env 不提交入库）。
# 已设置的 OS 环境变量优先，.env 不覆盖——CI/容器注入安全。

# 环境名：决定合并 devops-id-<env>.yaml（dev / test / prod）
APP_ENV=dev

# 服务版本号：本地 go run 时显示在 banner；CI/CD 用 -ldflags 注入时优先级更高
APP_VERSION=0.1.0-dev

# Nacos 注册 IP：本地进程注册到 Nacos 的地址，必须是 Higress/客户端可回连的宿主机局域网 IPv4
# 不设置时代码自动选首个非 loopback IPv4
NACOS_REGISTER_IP=192.168.1.20
